PORT=5000
# Local development:
MONGODB_URI=mongodb://localhost:27017/team-time-off-tracker
# Inside Docker Compose the host is the service name, not localhost:
# MONGODB_URI=mongodb://mongodb:27017/team-time-off-tracker

# --- Authentication (required) ---
# Generate one with: openssl rand -base64 48
JWT_SECRET=
# Any jsonwebtoken duration string, e.g. 30m, 12h, 7d. The session cookie's
# maxAge is derived from this, so the cookie never outlives the token.
JWT_EXPIRES_IN=1h

# --- Browser clients (required for credentialed cookies) ---
# Credentialed cookies cannot be combined with a wildcard origin, so list the
# allowed origins explicitly. Comma-separate for more than one.
CORS_ORIGIN=http://localhost:5173

# --- Initial admin, used by `npm run seed` ---
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@example.com
# Minimum 8 characters. Never reuse this value in production.
ADMIN_PASSWORD=


# Email (SMTP) — defaults target the Mailpit service in docker-compose.
# Running the backend on the host instead? Use localhost, same port.
EMAIL_SENDER_SMTP_HOST=localhost
EMAIL_SENDER_SMTP_PORT=1025
# Leave blank for Mailpit. Set both for a real relay.
EMAIL_SENDER_SMTP_USER=
EMAIL_SENDER_SMTP_PASS=
EMAIL_SENDER_FROM=no-reply@team-time-off-tracker.local
